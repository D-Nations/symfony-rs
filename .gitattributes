# Scripts and the files they read keep LF endings on Windows checkouts.
*.sh text eol=lf
*.php text eol=lf
*.tsv text eol=lf
# Vectors recorded from PHP are compared byte for byte.
**/tests/data/** -text
# Upstream test fixtures stay byte for byte as upstream ships them.
**/tests/Fixtures/** -text
**/tests/yaml-test-suite/** -text
**/tests/fixtures/** -text
# Rendered from upstream and served byte for byte.
crates/http-kernel/resources/** -text
# The DI trial demo's container is recorded from PHP and seeds the build hash.
spikes/di-trial/demo/data/** -text
